{
  "name": "puurk-partner-sample",
  "version": "0.2.2",
  "description": "Sample partner integration that exercises the Puurk REST API and webhooks",
  "private": true,
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "smoke": "node src/smoke_test.js",
    "report": "node src/report.js",
    "webhook": "node src/webhook_server.js",
    "webhook:dev": "node --watch src/webhook_server.js",
    "register-webhook": "node src/register_webhook.js",
    "send-test-event": "node src/send_test_event.js",
    "tunnel": "ngrok http 4747",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
