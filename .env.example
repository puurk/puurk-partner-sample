# Puurk API base URL (no trailing slash)
#   Production: https://api.puurk.com
#   Sandbox:    https://apisandbox.puurk.com
PUURK_API_BASE_URL=https://apisandbox.puurk.com

# API client credentials (POST /auth/token exchange) — your partner bootstrap
# credential, issued by Puurk when you request sandbox access (api@puurk.com).
# The client_secret is shown once at issuance; store it in a secrets manager.
PUURK_CLIENT_ID=your-partner-client-id
PUURK_CLIENT_SECRET=your-one-time-client-secret

# Your organization id (used for org-scoped smoke checks) — returned by the
# one-time POST /sandbox/organizations provisioning call (see README Quick
# start); looks like sandbox-org-<yourslug>.
PUURK_OID=sandbox-org-yourslug

# Webhook receiver
WEBHOOK_PORT=4747
WEBHOOK_PATH=/webhook
# Supply your own secret when registering (GET /webhooks masks server-generated
# secrets after creation, so a self-supplied secret is easier to manage)
WEBHOOK_SECRET=
# Public HTTPS URL that Puurk should deliver events to (e.g. an ngrok tunnel).
# Used by `npm run register-webhook`.
WEBHOOK_PUBLIC_URL=
# Reject deliveries whose signature timestamp drifts more than this many
# seconds from the current time. 0 disables the check.
SIGNATURE_TOLERANCE_SECONDS=300

# Example storefront (npm run storefront)
STOREFRONT_PORT=4848
# Offer "Pay in full" in the embedded checkout. Set to false if you take full
# payments through another channel and use Puurk only for payment plans.
STOREFRONT_PAY_IN_FULL=true
# Down payment collected up front on payment plans, as a percent of the cart
# (0-100). Sent to Puurk as the session's down_payment and used for the
# "as low as" pricing. 0 finances the whole amount.
STOREFRONT_DOWN_PAYMENT_PERCENT=10
# The online menu. List service ids (comma-separated, in display order) to
# curate it, or leave empty to take a varied selection from the catalog: up to
# STOREFRONT_MAX_SERVICES treatments and STOREFRONT_MAX_PACKAGES packages
# priced between STOREFRONT_MIN_PRICE and STOREFRONT_MAX_PRICE (cents).
STOREFRONT_SERVICE_IDS=
STOREFRONT_MAX_SERVICES=12
STOREFRONT_MAX_PACKAGES=4
STOREFRONT_MIN_PRICE=10000
STOREFRONT_MAX_PRICE=2500000
# @puurk/js environment for the browser checkout: sandbox | staging | demo |
# production. Must match PUURK_API_BASE_URL.
PUURK_ENVIRONMENT=sandbox
# Where the browser loads @puurk/js from. Empty = the vendored build at
# /vendor/puurk.js; use https://js.puurk.com/v1/puurk.js once the CDN is live.
PUURK_JS_URL=
# Local testing only: send the browser SDK's checkout calls to another API
# (e.g. a checkout-service emulator) instead of the environment's gateway.
PUURK_JS_API_URL=
