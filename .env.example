# Puurk API base URL (no trailing slash)
#   Production: https://api.puurk.com
#   Sandbox:    https://apisandbox.puurk.com
PUURK_API_BASE_URL=https://apisandbox.puurk.com

# API client credentials (POST /auth/token exchange) — your partner bootstrap
# credential, issued by Puurk when you request sandbox access (api@puurk.com).
# The client_secret is shown once at issuance; store it in a secrets manager.
PUURK_CLIENT_ID=your-partner-client-id
PUURK_CLIENT_SECRET=your-one-time-client-secret

# Your organization id (used for org-scoped smoke checks) — returned by the
# one-time POST /sandbox/organizations provisioning call (see README Quick
# start); looks like sandbox-org-<yourslug>.
PUURK_OID=sandbox-org-yourslug

# Webhook receiver
WEBHOOK_PORT=4747
WEBHOOK_PATH=/webhook
# Supply your own secret when registering (GET /webhooks masks server-generated
# secrets after creation, so a self-supplied secret is easier to manage)
WEBHOOK_SECRET=
# Public HTTPS URL that Puurk should deliver events to (e.g. an ngrok tunnel).
# Used by `npm run register-webhook`.
WEBHOOK_PUBLIC_URL=
# Reject deliveries whose signature timestamp drifts more than this many
# seconds from the current time. 0 disables the check.
SIGNATURE_TOLERANCE_SECONDS=300
